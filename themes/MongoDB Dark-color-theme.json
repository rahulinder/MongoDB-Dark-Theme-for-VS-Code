    "terminal.foreground": "#F9FBFA",
    "terminal.ansiBlack": "#001E2B",
    "terminal.ansiBlue": "#00E6FF",
    "terminal.ansiBrightBlack": "#889396",
    "terminal.ansiBrightBlue": "#57D3E2",
    "terminal.ansiBrightCyan": "#57D3E2",
    "terminal.ansiBrightGreen": "#00ED64",
    "terminal.ansiBrightMagenta": "#C792EA",
    "terminal.ansiBrightRed": "#FF6F60",
    "terminal.ansiBrightWhite": "#FFFFFF",
    "terminal.ansiBrightYellow": "#F4E97C",
    "terminal.ansiCyan": "#00E6FF",
    "terminal.ansiGreen": "#00684A",
    "terminal.ansiMagenta": "#C792EA",
    "terminal.ansiRed": "#FF6F60",
    "terminal.ansiWhite": "#F9FBFA",
    "terminal.ansiYellow": "#E5DA79"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#6F8A80",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": "string",
      "settings": {
        "foreground": "#E5DA79"
      }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "meta.brace"],
      "settings": {
        "foreground": "#A2B5B0"
      }
    },
    {
      "name": "Control Keywords",
      "scope": ["keyword", "keyword.control", "storage.modifier"],
      "settings": {
        "foreground": "#00ED64",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Data Types & Classes",
      "scope": ["storage.type", "entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": {
        "foreground": "#6BD13B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables",
      "scope": ["variable", "string constant.other.placeholder"],
      "settings": {
        "foreground": "#F9FBFA"
      }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": {
        "foreground": "#00E6FF"
      }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#BDE6FF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Numbers & Booleans",
      "scope": ["constant.numeric", "constant.language.boolean"],
      "settings": {
        "foreground": "#FF9854"
      }
    },
    {
      "name": "Properties",
      "scope": ["variable.other.property", "meta.property-name", "support.type.property-name"],
      "settings": {
        "foreground": "#57D3E2"
      }
    },
    {
      "name": "HTML/XML Tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": {
        "foreground": "#00ED64"
      }
    },
    {
      "name": "HTML/XML Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#57D3E2",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#00ED64"
      }
    }
  ]
}